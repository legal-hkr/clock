<?xml version="1.0" encoding="utf-8"?>
<!-- Pause and Resume on the timer widget: a rounded square on surface. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
