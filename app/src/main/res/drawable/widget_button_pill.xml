<?xml version="1.0" encoding="utf-8"?>
<!-- A button of the timer widget as a pill: a small surface of its own on the wallpaper. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
