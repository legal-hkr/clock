<?xml version="1.0" encoding="utf-8"?>
<!-- The time's pill on the digital clock widget: a small surface of its own, straight on the wallpaper. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
