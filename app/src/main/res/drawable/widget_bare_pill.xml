<?xml version="1.0" encoding="utf-8"?>
<!-- A preset on the timer widget: see-through white with white text, as designed, at 40 % – the designed 22 % left the pill too faint on a light wallpaper (owner, 13 Nov 2026). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
