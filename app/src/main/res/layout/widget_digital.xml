<?xml version="1.0" encoding="utf-8"?>
<!-- Digital clock (lighter widgets handoff of 13 Nov 2026, §3): no card. A light cookie with the date, over it a pill with the time and the day's name, under that a small pill with the next alarm – the arrangement of Music's player widget. The group keeps its size and stands at the widget's start; sizes are in dp, text too, as the shapes can't grow with the font. Also the picker's preview. -->
<!-- The outer frame is there for the launcher: a widget that names its background and clips to it is left alone, where otherwise the whole widget is cut to the system's rounded corners. The frame draws nothing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription,UseCompoundDrawables,UselessParent"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="164dp"
        android:layout_gravity="center_vertical|start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="0dp"
        android:paddingEnd="4dp">

        <FrameLayout
            android:id="@+id/cookie"
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_cookie" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="EEE"
                    android:format24Hour="EEE"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_secondary_container"
                    android:textSize="14dp" />

                <!-- The margins take away the empty room a line keeps above and below its digits -->
                <TextClock
                    android:id="@+id/day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:layout_marginBottom="-6dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="d"
                    android:format24Hour="d"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_secondary_container"
                    android:textSize="56dp" />

                <TextClock
                    android:id="@+id/month"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="MMM"
                    android:format24Hour="MMM"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_secondary_container"
                    android:textSize="14dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Over the cookie by 24 dp, and above it: the shadow is Music's, 2 dp of elevation -->
        <LinearLayout
            android:id="@+id/time_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="128dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_float_surface"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <TextClock
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-2dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="40dp" />

            <TextClock
                android:id="@+id/day_name"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="14dp" />
        </LinearLayout>

        <!-- The pill is 40 dp in a target of 48 -->
        <FrameLayout
            android:id="@+id/alarm"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="128dp"
            android:layout_marginTop="106dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/alarm_pill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/widget_float_primary"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/alarm_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alarm"
                    android:tint="@color/widget_on_primary" />

                <TextView
                    android:id="@+id/alarm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_primary"
                    android:textSize="14dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
