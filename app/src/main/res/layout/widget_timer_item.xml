<?xml version="1.0" encoding="utf-8"?>
<!-- A timer on the widget (SPEC §3.10.4): its label, the time left counted down by the system's chronometer, "+1:00" where there is room, and Pause, Resume or Stop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="28dp" />

        <TextView
            android:id="@+id/left_paused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="28dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/plus"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textColor="@color/widget_on_secondary_container"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_circle_primary"
        android:tint="@color/widget_on_primary" />
</LinearLayout>
