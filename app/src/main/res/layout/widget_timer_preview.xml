<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for the timer: its name and a row of presets with "+". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription,UselessParent,UseCompoundDrawables"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hourglass_empty"
                android:tint="@android:color/white" />

            <TextView
                style="@style/WidgetBareText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_nav_timer"
                android:textSize="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp">

                <TextView
                    style="@style/WidgetBareText"
                    android:text="@string/widget_preview_preset_1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_bare_pill"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxWidth="160dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp">

                <TextView
                    style="@style/WidgetBareText"
                    android:text="@string/widget_preview_preset_2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_bare_pill"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxWidth="160dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp">

                <TextView
                    style="@style/WidgetBareText"
                    android:text="@string/widget_preview_preset_3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_bare_pill"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxWidth="160dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp">

                <TextView
                    style="@style/WidgetBareText"
                    android:text="@string/widget_preview_preset_4"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_bare_pill"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxWidth="160dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="14dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_bare_circle"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_add"
                    android:tint="@android:color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
