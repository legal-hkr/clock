<?xml version="1.0" encoding="utf-8"?>
<!-- Timer (further widgets handoff of 13 Nov 2026, §5): no card and no lines. One timer – the first in the app's order – stands on the wallpaper in white: its name, with the number of the others after it; its time in a light weight with the two buttons of its state on surfaces of their own; under them one row of presets as see-through pills, then "+". With no timer: the widget's name and up to two rows of presets. One row high: the time and buttons alone, or the presets alone. What is shown is chosen in code; sizes are in dp, text too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription,UselessParent,UseCompoundDrawables"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipChildren="false"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hourglass_empty"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/title"
                style="@style/WidgetBareText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/name_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- The name gives way to the count of the other timers: in a frame it is only as wide as its text -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/label"
                        style="@style/WidgetBareText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/more"
                        style="@style/WidgetBareText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:alpha="0.8"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/time_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- The margins take away the empty room a line keeps above and below its digits -->
            <FrameLayout
                android:id="@+id/open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="-8dp"
                android:layout_weight="1">

                <Chronometer
                    android:id="@+id/left"
                    style="@style/WidgetBareText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.023"
                    android:textSize="64dp" />

                <TextView
                    android:id="@+id/left_paused"
                    style="@style/WidgetBareText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.023"
                    android:textSize="64dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/plus"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button_pill"
                android:elevation="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/widget_on_surface"
                android:textSize="14dp" />

            <ImageButton
                android:id="@+id/delete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button_circle"
                android:elevation="2dp"
                android:src="@drawable/ic_delete"
                android:tint="@color/widget_error" />

            <!-- Pause and Resume: a rounded square, 56 dp wide -->
            <ImageButton
                android:id="@+id/action"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_button_square"
                android:elevation="2dp"
                android:tint="@color/widget_on_surface" />

            <!-- Stop: round -->
            <ImageButton
                android:id="@+id/stop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_button_circle"
                android:elevation="2dp"
                android:src="@drawable/ic_stop"
                android:tint="@color/widget_on_surface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/presets1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/presets2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
