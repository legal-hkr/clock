<?xml version="1.0" encoding="utf-8"?>
<!-- Its settings (a see-through cookie) open from the widget; placing it asks nothing. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="sh.hnet.clock.widget.ClockWidgetSettingsActivity"
    android:description="@string/widget_analog_description"
    android:initialLayout="@layout/widget_analog"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_analog"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
